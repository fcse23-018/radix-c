CREATE TABLE SoilSample (
    id TEXT PRIMARY KEY,
    timestamp INTEGER NOT NULL,
    latitude REAL,
    longitude REAL,
    altitude REAL,
    socPercentage REAL NOT NULL,
    confidenceInterval REAL NOT NULL,
    somPercentage REAL NOT NULL,
    labValue REAL,
    moistureContent REAL,
    imageHash TEXT NOT NULL,
    provenanceHash TEXT NOT NULL,
    cameraParams TEXT NOT NULL,
    colorFeatures TEXT NOT NULL,
    textureFeatures TEXT NOT NULL,
    modelVersion TEXT NOT NULL,
    appVersion TEXT NOT NULL,
    isSynced INTEGER NOT NULL DEFAULT 0,
    notes TEXT
);

CREATE INDEX idx_timestamp ON SoilSample(timestamp);
CREATE INDEX idx_location ON SoilSample(latitude, longitude);
CREATE INDEX idx_synced ON SoilSample(isSynced);

selectAllSamples:
SELECT * FROM SoilSample ORDER BY timestamp DESC;

selectSampleById:
SELECT * FROM SoilSample WHERE id = ?;

selectSamplesByDateRange:
SELECT * FROM SoilSample WHERE timestamp BETWEEN ? AND ? ORDER BY timestamp DESC;

selectUnsyncedSamples:
SELECT * FROM SoilSample WHERE isSynced = 0;

insertSample:
INSERT INTO SoilSample (
    id, timestamp, latitude, longitude, altitude,
    socPercentage, confidenceInterval, somPercentage, labValue, moistureContent,
    imageHash, provenanceHash, cameraParams, colorFeatures, textureFeatures,
    modelVersion, appVersion, isSynced, notes
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateSampleSyncStatus:
UPDATE SoilSample SET isSynced = 1 WHERE id = ?;

deleteSample:
DELETE FROM SoilSample WHERE id = ?;

deleteAllSamples:
DELETE FROM SoilSample;
