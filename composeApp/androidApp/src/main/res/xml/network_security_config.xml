<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base configuration for all domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- System trust anchors -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- ISRIC SoilGrids (Netherlands) -->
    <domain-config>
        <domain includeSubdomains="true">maps.isric.org</domain>
        <domain includeSubdomains="true">rest.isric.org</domain>
        <pin-set>
            <!-- Add actual certificate hashes after obtaining from ISRIC -->
            <!-- sha256/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= -->
        </pin-set>
    </domain-config>

    <!-- Google Earth Engine (Google) -->
    <domain-config>
        <domain includeSubdomains="true">earthengine.googleapis.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Debug configuration for development -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
