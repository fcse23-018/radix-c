<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive user data from cloud backup -->
        <exclude domain="sharedpref" path="encryption_keys.xml" />
        <exclude domain="database" path="terrochroma.db" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude sensitive user data from device transfer -->
        <exclude domain="sharedpref" path="encryption_keys.xml" />
        <exclude domain="database" path="terrochroma.db" />
    </device-transfer>
</data-extraction-rules>
